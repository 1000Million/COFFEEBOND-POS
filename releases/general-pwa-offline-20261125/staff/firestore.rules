        && saved.expiresAt > request.time
        && saved.orderId is string
        && saved.orderId.size() > 0
        && saved.canonicalItems is map
        && saved.canonicalAddOnTotal is number
        && saved.canonicalAddOnTotal >= 0
        && proposed.used == true
        && proposed.usedAt is timestamp
        && proposed.orderNumber is string
        && proposed.orderNumber.size() > 0
        && proposed.diff(saved).affectedKeys().hasOnly([
          'used',
          'usedAt',
          'orderNumber'
        ])
        && order.addOnAuthorizationId == authorizationId
        && order.createdByUserId == request.auth.uid
        && order.storeId == saved.storeId
        && order.orderNumber == proposed.orderNumber
        && legacyConsumedFinancials(saved.orderId, order, saved);
    }

    function isOrderVoidUpdate() {
      return (isAdmin() || isStoreManager())
        && hasStoreAccess(resource.data.storeId)
        && resource.data.status != 'VOIDED'
        && request.resource.data.status == 'VOIDED'
        && orderIdentityUnchanged()
        && orderTotalsUnchanged()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidedAt is timestamp
        && ((isStoredComplimentaryOrder(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'voidReason',
            'voidedBy',
            'voidedByName',
            'voidedByEmail',
            'voidedAt',
            'updatedAt'
        ])) || (!isStoredComplimentaryOrder(resource.data)
          && isValidPaymentReversalStatus(request.resource.data.paymentReversalStatus)
          && request.resource.data.paymentReversalBreakdown is list
          && request.resource.data.paymentReversalTotal is number
          && request.resource.data.paymentReversalTotal >= 0
          && request.resource.data.refundedAmount is number
          && request.resource.data.refundedAmount >= 0
          && request.resource.data.reversedAmount is number
          && request.resource.data.reversedAmount >= 0
          && request.resource.data.refundPendingAmount is number
          && request.resource.data.refundPendingAmount >= 0
          && request.resource.data.manualRefundRequiredAmount is number
          && request.resource.data.manualRefundRequiredAmount >= 0
          && request.resource.data.netCollectionAmount is number
          && request.resource.data.netCollectionAmount >= 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'paymentReversalStatus',
          'paymentReversalBreakdown',
          'paymentReversalTotal',
          'refundedAmount',
          'reversedAmount',
          'refundPendingAmount',
          'manualRefundRequiredAmount',
          'netCollectionAmount',
          'voidReason',
          'voidedBy',
          'voidedByName',
          'voidedByEmail',
          'voidedAt',
          'updatedAt'
        ])));
    }

    function isValidOrderItemCreate(orderId, itemId) {
      let data = request.resource.data;
      let order = orderAfter(orderId);
      let authorization = getAfter(posAddOnAuthorizationPath(data.addOnAuthorizationId)).data;
      let line = authorization.canonicalItems[itemId];
      return isCheckoutStaffForStore(order.storeId)
        && data.status == 'PENDING'
        && data.addOnAuthorizationId == order.addOnAuthorizationId
        && authorization.canonicalItems is map
        && authorization.canonicalItems.keys().hasAll([itemId])
        && data.menuItemId == line.parentProductId
        && data.itemCode == line.parentProductCode
        && data.quantity == line.quantity
        && data.baseUnitPrice == line.baseUnitPrice
        && data.unitPrice == line.baseUnitPrice
        && data.taxRate == line.taxRate
        && data.addOns == line.addOns
        && data.addOnTotal == line.addOnTotal
        && data.addOns is list
        && data.addOns.size() <= 40
        && ((!line.keys().hasAny(['components'])
            && !data.keys().hasAny(['components']))
          || (line.keys().hasAll(['components'])
            && data.keys().hasAll(['components'])
            && data.components is list
            && data.components.size() <= 40
            && data.components == line.components))
        && data.baseUnitPrice is number
        && data.baseUnitPrice >= 0
        && data.addOnTotal is number
        && data.addOnTotal >= 0
        && data.unitPriceWithAddOns is number
        && data.unitPriceWithAddOns == data.baseUnitPrice + data.addOnTotal
        && data.lineSubtotal == data.unitPriceWithAddOns * data.quantity
        && (!isStoredComplimentaryOrder(order)
          || (data.lineSubtotal is number
            && data.lineSubtotal > 0
            && data.lineDiscount == data.lineSubtotal
            && data.lineTaxable == 0
            && data.lineTax == 0
            && data.lineTotal == 0))
        && hasValidInventoryConsumptionStatus(data)
        && hasCanonicalLineFinancials(order, authorization, itemId);
    }

    function isOrderItemStatusUpdate(orderId) {
      return isActiveStaff()
        && hasStoreAccess(orderAfter(orderId).storeId)
        && request.resource.data.status in ['PENDING', 'PREPARING', 'READY', 'SERVED', 'CANCELLED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function isValidPaymentCreate(orderId, paymentId) {
      let order = orderAfter(orderId);
      let payment = request.resource.data;
      return isCheckoutStaffForStore(order.storeId)
        && order.status != 'VOIDED'
        && order.paymentStatus != 'NOT_REQUIRED'
        && !isStoredComplimentaryOrder(order)
        && payment.keys().hasOnly([
          'method',
          'amount',
          'reference',
          'paymentIndex',
          'createdAt',
          'settledBy',
          'settledByName',
          'amountReceived',
          'changeDue'
        ])
        && isValidPaymentMethod(payment.method)
        && payment.amount is number
        && payment.amount >= 0
        && (!payment.keys().hasAny(['settledBy']) || payment.settledBy == request.auth.uid)
        && (!payment.keys().hasAny(['amountReceived']) || payment.amountReceived is number)
        && (!payment.keys().hasAny(['changeDue']) || payment.changeDue is number)
        && hasCanonicalPaymentCreate(orderId, paymentId, order);
    }

    function isPayAtCounterPlaceholderUpdate(orderId) {
      return isCheckoutStaff()
        && hasStoreAccess(orderAfter(orderId).storeId)
        && resource.data.method == 'PAY_AT_COUNTER'
        && request.resource.data.method == resource.data.method
        && request.resource.data.amount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'reference']);
    }

    function isConfiguredInventoryStorePair(logicalStoreId, inventoryStoreId) {
      let logical = get(/databases/$(database)/documents/stores/$(logicalStoreId)).data;
      let physical = get(/databases/$(database)/documents/stores/$(inventoryStoreId)).data;
      let target = logical.get('inventoryStoreId', '');
      let physicalTarget = physical.get('inventoryStoreId', '');
      return logicalStoreId is string && inventoryStoreId is string
        && exists(/databases/$(database)/documents/stores/$(logicalStoreId))
        && exists(/databases/$(database)/documents/stores/$(inventoryStoreId))
        && target is string
        && ((target.size() > 0 && target == inventoryStoreId)
          || (target.size() == 0 && logicalStoreId == inventoryStoreId))
        && physicalTarget is string
        && (physicalTarget.size() == 0 || physicalTarget == inventoryStoreId);
    }

    function hasValidInventoryStoreAttribution(data) {
      return (data.keys().hasAll([
          'inventoryStoreId',
          'logicalSalesStoreId',
          'logicalSalesStoreCode',
          'logicalSalesStoreName'
        ])
        && data.inventoryStoreId == data.storeId
        && data.logicalSalesStoreId is string
        && hasStoreAccess(data.inventoryStoreId)
        && (data.logicalSalesStoreId == data.inventoryStoreId || hasStoreAccess(data.logicalSalesStoreId))
        && isConfiguredInventoryStorePair(data.logicalSalesStoreId, data.inventoryStoreId)
        && data.storeCode == get(/databases/$(database)/documents/stores/$(data.inventoryStoreId)).data.code
        && data.storeName == get(/databases/$(database)/documents/stores/$(data.inventoryStoreId)).data.name
        && data.logicalSalesStoreCode == get(/databases/$(database)/documents/stores/$(data.logicalSalesStoreId)).data.code
        && data.logicalSalesStoreName == get(/databases/$(database)/documents/stores/$(data.logicalSalesStoreId)).data.name
        && data.orderId is string
        && data.logicalSalesStoreId == orderAfter(data.orderId).storeId)
        || (!data.keys().hasAny([
            'inventoryStoreId',
            'logicalSalesStoreId',
            'logicalSalesStoreCode',
            'logicalSalesStoreName'
          ])
          && data.orderId is string
          && data.storeId == orderAfter(data.orderId).storeId
          && hasStoreAccess(data.storeId)
          && isConfiguredInventoryStorePair(data.storeId, data.storeId));
    }

    // A void must restore the exact physical pool recorded by the immutable
    // original sale movement. It deliberately does not re-resolve the store's
    // current alias or mutable display names: either may legitimately change
    // after the sale, while the historical movement remains authoritative.
    function hasValidVoidReversalInventoryAttribution(data) {
      return data.movementType == 'ORDER_VOID_REVERSAL'
        && data.keys().hasAll([
          'inventoryStoreId',
          'logicalSalesStoreId',
          'logicalSalesStoreCode',
          'logicalSalesStoreName',
          'originalMovementId',
          'originalMovementType'
        ])
        && data.originalMovementId is string
        && data.originalMovementId.size() > 0
        && exists(/databases/$(database)/documents/stockMovements/$(data.originalMovementId))
        && get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.movementType in [
          'SALE_DEDUCTION',
          'ORDER_BOM_BACKFILL'
        ]
        && data.originalMovementType == get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.movementType
        && data.orderId is string
        && data.orderId == get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.orderId
        && data.storeId == get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.storeId
        && data.inventoryStoreId == data.storeId
        && data.logicalSalesStoreId == orderAfter(data.orderId).storeId
        && (
          (get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.keys().hasAll([
              'inventoryStoreId',
              'logicalSalesStoreId'
            ])
            && data.inventoryStoreId == get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.inventoryStoreId
            && data.logicalSalesStoreId == get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.logicalSalesStoreId)
          || (!get(/databases/$(database)/documents/stockMovements/$(data.originalMovementId)).data.keys().hasAny([
              'inventoryStoreId',
              'logicalSalesStoreId'
            ])
            && data.inventoryStoreId == data.logicalSalesStoreId)
        )
        && hasStoreAccess(data.inventoryStoreId)
        && hasStoreAccess(data.logicalSalesStoreId);
    }

    function hasValidOptionalInventoryStoreAttribution(data) {
      return !data.keys().hasAny([
          'inventoryStoreId',
          'logicalSalesStoreId',
          'logicalSalesStoreCode',
          'logicalSalesStoreName'
        ])
        || (data.keys().hasAll([
            'inventoryStoreId',
            'logicalSalesStoreId',
            'logicalSalesStoreCode',
            'logicalSalesStoreName'
          ])
          && (
            (data.movementType == 'ORDER_VOID_REVERSAL'
              && hasValidVoidReversalInventoryAttribution(data))
            || (data.movementType != 'ORDER_VOID_REVERSAL'
              && hasValidInventoryStoreAttribution(data))
          ));
    }

    function hasInventoryRecordStoreAccess(data) {
      return hasStoreAccess(data.storeId)
        && (
          !data.keys().hasAny([
            'inventoryStoreId',
            'logicalSalesStoreId',
            'logicalSalesStoreCode',
            'logicalSalesStoreName'
          ])
          || (data.keys().hasAll([
              'inventoryStoreId',
              'logicalSalesStoreId',
              'logicalSalesStoreCode',
              'logicalSalesStoreName'
            ])
            && data.inventoryStoreId == data.storeId
            && hasStoreAccess(data.logicalSalesStoreId)
            && isConfiguredInventoryStorePair(data.logicalSalesStoreId, data.inventoryStoreId))
        );
    }

    function isSaleDeductionMovement() {
      let data = request.resource.data;
      return data.movementType == 'SALE_DEDUCTION'
      && data.referenceType == 'ORDER'
      && data.storeId is string
      && hasStoreAccess(data.storeId)
      && hasValidInventoryStoreAttribution(data)
      && data.stockSystem == 'MENU_MANAGEMENT'
      && data.stockItemType in ['RAW_INGREDIENT', 'PREP_ITEM', 'FINISHED_GOOD', 'PACKAGING', 'BOUGHT_COMPONENT']
      && data.quantity is number
      && data.quantity <= 0
      && data.quantityDelta is number
      && data.quantityDelta <= 0
      && data.newQty is number
      && data.previousQty is number
      && data.newQty <= data.previousQty
      && data.createdByUserId == request.auth.uid;
    }

    function isCheckoutStoreStockDeduction() {
      return isCheckoutStaffForStore(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock <= resource.data.currentStock
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock', 'updatedAt']);
    }

    function isCheckoutStoreInventoryDeduction() {
      return isCheckoutStaffForStore(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.currentStock is number
        && request.resource.data.currentStock <= resource.data.currentStock
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock', 'updatedAt']);
    }

    // Metadata can be omitted by a client; protect the authoritative parent too.
    function isTableOrderId(orderId) {
      return orderId is string && orderId.size() > 0 && orderId.matches('[^/]+')
        && existsAfter(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']);
    }

    function referencesTableOrder(data) {
      let orderId = data.get('orderId', '');
      let referenceId = data.get('referenceId', '');
      return isTableOrderId(orderId) || (referenceId != orderId && isTableOrderId(referenceId));
    }

    function isValidKotCreate() {
      let data = request.resource.data;
      let line = orderItemAfter(data.orderId, data.orderItemId);
      return data.storeId is string
        && isCheckoutStaffForStore(data.storeId)
        && data.station in ['BARISTA', 'KITCHEN']
        && data.status == 'PENDING'
        && data.createdByUserId == request.auth.uid
        && data.addOns == line.addOns
        && ((!line.keys().hasAny(['components'])
            && !data.keys().hasAny(['component']))
          || (line.keys().hasAll(['components'])
            && data.keys().hasAll(['component'])
            && data.component is map
            && data.component in line.components
            && data.itemName == data.component.componentName
            && data.itemCode == data.component.componentFinishedGoodCode
            && data.quantity == line.quantity * data.component.quantity
            && (data.component.prepStation == data.station
              || data.component.prepStation == 'BOTH')));
    }

    function isValidTableKotUpdate() {
      return isActiveStaff() && canReadKot(resource.data)
        && ((resource.data.status == 'PENDING' && request.resource.data.status in ['PREPARING','READY','SERVED'])
          || (resource.data.status == 'PREPARING' && request.resource.data.status == 'READY')
          || (resource.data.status == 'READY' && request.resource.data.status == 'SERVED'))
        && request.resource.data.tablePreparationStarted == true
        && ((resource.data.get('tablePreparationStarted',false) == true && request.resource.data.tablePreparationStartedAt == resource.data.tablePreparationStartedAt)
          || (resource.data.get('tablePreparationStarted',false) == false && request.resource.data.tablePreparationStartedAt == request.time))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','readyAt','servedAt','handledByUserId','handledByName','tablePreparationStarted','tablePreparationStartedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['handledByUserId']) || request.resource.data.handledByUserId == request.auth.uid);
    }

    function isValidKotUpdate() {
      return isActiveStaff()
        && canReadKot(resource.data)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.orderNumber == resource.data.orderNumber
        && request.resource.data.orderItemId == resource.data.orderItemId
        && request.resource.data.station == resource.data.station
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && isValidKotStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'readyAt',
          'servedAt',
          'cancelledAt',
          'cancelledBy',
          'cancelledByName',
          'cancellationReason',
          'handledByUserId',
          'handledByName',
          'voidReason',
          'returnedAt',
          'returnReason',
          'wastageAt',
          'wastageReason',
          'remakeRequestedAt',
          'remakeReason'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['handledByUserId']) || request.resource.data.handledByUserId == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelledBy']) || request.resource.data.cancelledBy == request.auth.uid);
    }

    function canReadKot(data) {
      return isAdmin()
        || (isStoreManager() && hasStoreAccess(data.storeId))
        || (isCashier() && hasStoreAccess(data.storeId))
        || (isBarista() && data.station == 'BARISTA' && hasStoreAccess(data.storeId))
        || (isKitchen() && data.station == 'KITCHEN' && hasStoreAccess(data.storeId));
    }

    function isSafePublicTrackingDocument(data, trackingToken) {
      return data.keys().hasOnly([
        'trackingToken',
        'publicOrderReference',
        'storeName',
        'orderType',
        'tableNumber',
        'items',
        'subtotal',
        'gstTotal',
        'total',
        'publicStatus',
        'submittedAt',
        'acceptedAt',
        'readyAt',
        'servedAt',
        'publicOrderNumber',
        'paymentProvider',
        'paymentStatus',
        'paymentAvailableUntil',
        'customerStatusMessage'
      ])
      && data.trackingToken == trackingToken
      && data.trackingToken is string
      && data.trackingToken.size() >= 32
      && data.publicOrderReference is string
      && data.publicOrderReference.size() > 0
      && data.publicOrderReference.size() <= 32
      && data.storeName is string
      && data.storeName.size() > 0
      && data.storeName.size() <= 80
      && data.orderType in ['PICKUP', 'DINE_IN']
      && (
        (data.orderType == 'DINE_IN'
          && data.tableNumber is string
          && data.tableNumber.size() > 0
          && data.tableNumber.size() <= 20)
        || (data.orderType == 'PICKUP'
          && (!data.keys().hasAny(['tableNumber']) || data.tableNumber == null))
      )
      && data.items is list
      && data.items.size() > 0
      && data.items.size() <= 30
      && data.subtotal is number
      && data.gstTotal is number
      && data.total is number
      && data.subtotal >= 0
      && data.gstTotal >= 0
      && data.total >= 0
      && data.publicStatus in ['PENDING', 'PAYMENT_PROCESSING', 'PAID_PENDING_ACCEPTANCE', 'ACCEPTED', 'ACCEPTED_AWAITING_PAYMENT', 'CONVERTED', 'PREPARING', 'READY', 'SERVED', 'COMPLETED', 'REJECTED', 'NEEDS_ATTENTION', 'CANCELLED', 'REFUND_PENDING', 'REFUNDED', 'REFUND_FAILED', 'CANCELLED_REFUNDED', 'PAYMENT_REVIEW_REQUIRED']
      && (!data.keys().hasAny(['paymentProvider']) || data.paymentProvider in ['PAY_AT_COUNTER', 'RAZORPAY'])
      && (!data.keys().hasAny(['paymentStatus']) || data.paymentStatus in ['NOT_STARTED', 'AWAITING_PAYMENT', 'PAYMENT_PROCESSING', 'FAILED', 'PAID', 'REFUND_PENDING', 'REFUNDED', 'REFUND_FAILED', 'PAYMENT_REVIEW_REQUIRED'])
      && (!data.keys().hasAny(['paymentAvailableUntil']) || data.paymentAvailableUntil is timestamp)
      && data.customerStatusMessage is string
      && data.customerStatusMessage.size() > 0
      && data.customerStatusMessage.size() <= 160
      && data.submittedAt is timestamp
      && (!data.keys().hasAny(['acceptedAt']) || data.acceptedAt is timestamp)
      && (!data.keys().hasAny(['readyAt']) || data.readyAt is timestamp)
      && (!data.keys().hasAny(['servedAt']) || data.servedAt is timestamp)
      && (!data.keys().hasAny(['publicOrderNumber']) || (data.publicOrderNumber is string && data.publicOrderNumber.size() <= 80));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isAdmin() && !isFranchiseProfile(request.resource.data);
      allow update: if isAdmin()
        && !isFranchiseProfile(resource.data)
        && !isFranchiseProfile(request.resource.data);
      allow delete: if isAdmin() && !isFranchiseProfile(resource.data);
    }

    // Admin SDK callables create and manage these append-only audit records.
    match /franchiseAccessAudit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reportAccessAudit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // App Settings
    match /appSettings/{document} {
      allow get: if isActiveStaff() || document == 'gstConfig';
      allow list: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /appSettings/{document=**} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    // Stores
    match /stores/{storeId} {
      // Anonymous customer ordering may discover active locations. Signed-in
      // non-admin staff remain limited to their explicit store assignments.
      // Draft/inactive location configuration is restricted to active Admin users.
      allow read: if isAdmin()
        || (!isSignedIn() && resource.data.isActive == true)
        || (
          isActiveStaff()
          && (
            resource.data.isActive == true
            || (isStoreManager() && resource.data.internalPosTestEnabled == true)
          )
          && hasStoreAccess(storeId)
        );
      // All store mutations use Admin SDK callables so provisioning, immutable
      // codes, readiness gates, activation, and audit history cannot be bypassed.
      allow create, update, delete: if false;
    }

    match /storeProvisioningJobs/{jobId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /storeProvisioningAudit/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    // Categories
    match /categories/{categoryId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }
    
    match /importDiagnostics/{docId} {
      allow read, write: if isAdmin();
    }

    match /importManifests/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Menu Items
    match /menuItems/{itemId} {
      allow read: if isActiveStaff();
      allow create, delete: if isAdmin();
      // Admin can update all fields.
      // Store Manager can only update availableStoreIds.
      allow update: if isAdmin() || (isStoreManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableStoreIds', 'updatedAt']));
    }
    
    // Counters
    match /counters/{counterId} {
      allow read: if isCheckoutStaff();
      allow write: if isCheckoutStaff();
    }

    // Customers
    match /customers/{customerId} {
      allow get, list: if isCheckoutStaff();
      allow create, update: if isCheckoutStaff();
      allow delete: if isAdmin();
    }

    match /onlineOrders/{onlineOrderId} {
      allow create: if isCheckoutStaff() && hasStoreAccess(request.resource.data.storeId);
      allow get, list: if isCheckoutStaff() && (isAdmin() || hasStoreAccess(resource.data.storeId));
      allow update: if isCheckoutStaff()
        && (isAdmin() || hasStoreAccess(resource.data.storeId))
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.items == resource.data.items
        // Paid gateway orders are accepted or refunded only by secured callables.
        && resource.data.paymentProvider != 'RAZORPAY';
      allow delete: if isAdmin() && resource.data.paymentProvider != 'RAZORPAY';
    }

    match /publicOrderTracking/{trackingToken} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isSafePublicTrackingDocument(request.resource.data, trackingToken);
      allow update: if isActiveStaff()
        && isSafePublicTrackingDocument(request.resource.data, trackingToken)
        && request.resource.data.trackingToken == resource.data.trackingToken
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'publicStatus',
          'acceptedAt',
          'readyAt',
          'servedAt',
          'publicOrderNumber',
          'paymentProvider',
          'paymentStatus',
          'paymentAvailableUntil',
          'customerStatusMessage'
        ]);
      allow delete: if isAdmin();
    }

    match /publicMenuAvailability/{storeCode} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (isAdmin() || isStoreManager())
        && request.resource.data.storeCode == storeCode
        && hasStoreAccess(request.resource.data.storeId);
      allow delete: if isAdmin();
    }

    match /productImageAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Razorpay credentials, intents, verification state, and webhook audits are server-only.
    match /razorpayPaymentIntents/{intentId} {
      allow read, create, update, delete: if false;
    }

    match /razorpayWebhookEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Verified customer identity, canonical checkout data, reservations, and
    // refunds are available only through backend-authorised callables.
    match /customerProfiles/{customerUid} {
      allow read, create, update, delete: if false;
    }

    match /customerCheckoutSessions/{sessionId} {
      allow read, create, update, delete: if false;
    }

    // BOND financial and qualification state is written only by post-commit Admin
    // SDK workers. Verified customers may read only records bound to their Auth UID;
    // Store Managers, Cashiers and other customers gain no network-wide access.
    match /loyaltyAccounts/{customerId} {
      allow get: if (isSignedIn() && request.auth.uid == customerId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /loyaltyPointLedger/{ledgerEntryId} {
      allow get, list: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /clubMemberships/{membershipId} {
      allow get, list: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /qualifyingVisitEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /qualifyingVisitDays/{dayId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /loyaltyShadowLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /posRazorpaySessions/{sessionId} {
      allow read, create, update, delete: if false;
    }

    match /posRazorpayWebhookEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /inventoryReservations/{reservationId} {
      allow read, create, update, delete: if false;
    }

    match /razorpayRefunds/{refundId} {
      allow read, create, update, delete: if false;
    }

    match /addOnGroups/{groupId} {
      allow read: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }

    match /addOnGroupAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /productAddOnAudit/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /dayClosings/{closingId} {
      allow get: if isCheckoutStaff() && (
        !exists(/databases/$(database)/documents/dayClosings/$(closingId))
        || isAdmin()
        || hasStoreAccess(resource.data.storeId)
      );
      allow list: if isAdmin();
      allow create: if isCheckoutStaff() && hasStoreAccess(request.resource.data.storeId);
      allow update: if (isAdmin() || isStoreManager())
        && hasStoreAccess(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId;
      allow delete: if isAdmin();
    }

    match /purchaseEntries/{purchaseId} {
      allow read: if isActiveStaff() && (isAdmin() || hasStoreAccess(resource.data.storeId));
      allow create: if (isAdmin() || isStoreManager())
        && request.resource.data.storeId is string
        && hasStoreAccess(request.resource.data.storeId)
        && request.resource.data.status == 'POSTED';
      allow update, delete: if false;
    }

    match /purchaseDrafts/{draftId} {
      allow read: if isActiveStaff() && (isAdmin() || hasStoreAccess(resource.data.storeId));
      allow create, update, delete: if false;
    }

    // Created server-side; the client may only consume one with its exact order transaction.
    match /complimentaryAuthorizations/{authorizationId} {
      allow read: if isCheckoutStaff() && (isAdmin() || hasStoreAccess(resource.data.storeId));
      allow create, delete: if false;
      allow update: if isValidComplimentaryAuthorizationConsume(authorizationId);
    }

    // Created server-side; the client may only consume its own short-lived checkout authorization.
    match /posAddOnAuthorizations/{authorizationId} {
      allow read: if isCheckoutStaff()
        && resource.data.staffUid == request.auth.uid
        && hasStoreAccess(resource.data.storeId);
      allow create, delete: if false;
      allow update: if isValidPosAddOnAuthorizationConsume(authorizationId);
    }

    // Table sessions and effects are authoritative server writes only.
    match /tableServiceConfig/{storeId} { allow read: if isCheckoutStaff() && hasStoreAccess(storeId); allow write: if false; }
    match /tables/{tableId} { allow read: if isCheckoutStaff() && hasStoreAccess(resource.data.storeId); allow write: if false; }
    match /tableSessions/{sessionId} { allow read: if isCheckoutStaff() && hasStoreAccess(resource.data.storeId); allow write: if false; }
    match /tableOperations/{operationId} { allow read, write: if false; }
    match /tableAudit/{auditId} { allow read: if (isAdmin() || isStoreManager()) && hasStoreAccess(resource.data.storeId); allow write: if false; }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isCheckoutStaff() && (isAdmin() || hasStoreAccess(resource.data.storeId));
      allow create: if !request.resource.data.keys().hasAny(['tableSessionId']) && isValidOrderCreate(orderId);
      allow update: if resource != null && !resource.data.keys().hasAny(['tableSessionId']) && (isOrderSettlementUpdate() || isOrderVoidUpdate());
      allow delete: if isAdmin() && !get(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']);
      
      // Order Subcollections
      match /items/{itemId} {
        allow read: if isCheckoutStaff() && (isAdmin() || hasStoreAccess(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId));
        allow create: if !orderAfter(orderId).keys().hasAny(['tableSessionId']) && isValidOrderItemCreate(orderId, itemId);
        allow update: if resource != null && isOrderItemStatusUpdate(orderId);
        allow delete: if isAdmin() && !get(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']);
      }
      match /payments/{paymentId} {
        allow read: if isCheckoutStaff() && (isAdmin() || hasStoreAccess(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId));
        allow create: if !getAfter(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']) && isValidPaymentCreate(orderId, paymentId);
        allow update: if !get(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']) && isPayAtCounterPlaceholderUpdate(orderId);
        allow delete: if isAdmin() && !get(/databases/$(database)/documents/orders/$(orderId)).data.keys().hasAny(['tableSessionId']);
      }
    }

    match /kotItems/{kotId} {
      allow read: if isActiveStaff() && canReadKot(resource.data);
      
      allow create: if !request.resource.data.keys().hasAny(['tableSessionId']) && !isTableOrderId(request.resource.data.orderId) && isValidKotCreate();
      
      allow update: if resource != null && (resource.data.keys().hasAny(['tableSessionId']) ? isValidTableKotUpdate() : isValidKotUpdate());
      
      allow delete: if isAdmin() && !resource.data.keys().hasAny(['tableSessionId']);
    }

    match /inventoryItems/{itemId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /storeInventory/{stockId} {
      allow read: if isActiveStaff();
      allow create: if (isAdmin() || isStoreManager()) && hasStoreAccess(request.resource.data.storeId);
      allow update: if (isAdmin() || isStoreManager()) && hasStoreAccess(resource.data.storeId) 
                    || isCheckoutStoreInventoryDeduction();
      allow delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read: if isActiveStaff();
      allow create: if !request.resource.data.keys().hasAny(['tableSessionId']) && !referencesTableOrder(request.resource.data) && isCheckoutStaff()
        && hasStoreAccess(request.resource.data.storeId)
        && (
          ((isAdmin() || isStoreManager()) && hasValidOptionalInventoryStoreAttribution(request.resource.data))
          || isSaleDeductionMovement()
        );
      allow delete: if false; // no deletions
      allow update: if false; // no modifications
    }

    match /pendingInventoryConsumption/{pendingId} {
      allow read: if isActiveStaff() && (isAdmin() || hasInventoryRecordStoreAccess(resource.data));
      allow create: if !request.resource.data.keys().hasAny(['tableSessionId']) && !referencesTableOrder(request.resource.data) && isCheckoutStaff()
        && request.resource.data.keys().hasOnly([
          'storeId',
          'storeCode',
          'storeName',
          'inventoryStoreId',
          'logicalSalesStoreId',
          'logicalSalesStoreCode',
          'logicalSalesStoreName',
          'orderId',
          'orderNumber',
          'orderLineId',
          'finishedGoodId',
          'finishedGoodCode',
          'finishedGoodName',
          'quantitySold',
          'soldAt',
          'source',
          'status',
          'reason',
          'createdAt',
          'resolvedAt',
          'resolvedBy',
          'appliedBomVersion',
          'inventoryMovementIds',
          'idempotencyKey'
        ])
        && request.resource.data.storeId is string
        && hasStoreAccess(request.resource.data.storeId)
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && hasValidInventoryStoreAttribution(request.resource.data)
        && request.resource.data.status == 'PENDING_BOM'
        && request.resource.data.idempotencyKey == pendingId
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() > 0
        && request.resource.data.orderLineId is string
        && request.resource.data.orderLineId.size() > 0
        && request.resource.data.finishedGoodId is string
        && request.resource.data.finishedGoodId.size() > 0
        && request.resource.data.finishedGoodCode is string
        && request.resource.data.finishedGoodCode.size() > 0
        && request.resource.data.finishedGoodName is string
        && request.resource.data.finishedGoodName.size() > 0
        && request.resource.data.quantitySold is number
        && request.resource.data.quantitySold > 0
        && request.resource.data.soldAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.source in ['POS', 'CUSTOMER_WEB_ACCEPT']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.appliedBomVersion == null
        && request.resource.data.inventoryMovementIds is list
        && request.resource.data.inventoryMovementIds.size() == 0;
      allow update: if !isTableOrderId(resource.data.orderId) && (isAdmin() || isStoreManager())
        && (isAdmin() || hasInventoryRecordStoreAccess(resource.data))
        && resource.data.status == 'PENDING_BOM'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reason',
          'resolvedAt',
          'resolvedBy',
          'updatedAt'
        ])
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // --- Menu Management V2 Collections ---
    match /rawIngredients/{itemId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /prepItems/{itemId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    match /finishedGoods/{itemId} {
      allow read: if isActiveStaff();
      allow write: if isAdmin();
    }

    // Private per-store commercial and menu-presentation overrides.
    // Release 1B has no POS consumer, so only an active Admin may read or write them.
    match /storeItemConfig/{configId} {
      allow read, write: if isAdmin();
    }

    match /storeStock/{stockId} {
      allow read: if isActiveStaff();
      allow create: if ((isAdmin() || isStoreManager()) && hasStoreAccess(request.resource.data.storeId))
                    || (isCashier() && isSaleCreatedStoreStock(stockId));
      allow update: if (isAdmin() || isStoreManager()) && hasStoreAccess(resource.data.storeId)
                    || isCheckoutStoreStockDeduction();
      allow delete: if isAdmin();
    }

    match /prepProductions/{prodId} {
      allow read: if isActiveStaff();
      allow create: if (isAdmin() || isStoreManager()) && hasStoreAccess(request.resource.data.storeId);
      allow delete, update: if isAdmin();
    }
  }
}
