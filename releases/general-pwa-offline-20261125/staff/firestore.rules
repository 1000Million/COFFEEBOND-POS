rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUserProfile() {
      return hasUserProfile() && userData().isActive == true;
    }

    function hasRole(role) {
      let profile = isSignedIn() ? userData() : {};
      return isSignedIn() && profile.get('isActive', false) == true && profile.get('role', '') == role;
    }
    
    function isAdmin() {
      return hasRole('ADMIN');
    }
    
    function isStoreManager() {
      return hasRole('STORE_MANAGER');
    }

    function isCashier() {
      return hasRole('CASHIER');
    }

    function isBarista() {
      return hasRole('BARISTA');
    }

    function isKitchen() {
      return hasRole('KITCHEN');
    }
    
    function isActiveStaff() {
      let profile = isSignedIn() ? userData() : {};
      return isSignedIn() && profile.get('isActive', false) == true
        && profile.get('role', '') in ['ADMIN', 'STORE_MANAGER', 'CASHIER', 'BARISTA', 'KITCHEN', 'TRAINEE'];
    }

    function isFranchiseProfile(data) {
      return data.keys().hasAny(['role']) && data.role == 'FRANCHISE_VIEWER';
    }

    function isCheckoutStaff() {
      // Same active-profile/role contract; evaluate the profile once per call.
      let profile = isSignedIn() ? userData() : {};
      return isSignedIn() && profile.get('isActive', false) == true
        && profile.role in ['ADMIN', 'STORE_MANAGER', 'CASHIER'];
    }

    function isCheckoutStaffForStore(storeId) {
      let profile = isSignedIn() ? userData() : {};
      return isSignedIn() && profile.get('isActive', false) == true
        && profile.get('role', '') in ['ADMIN', 'STORE_MANAGER', 'CASHIER']
        && (profile.role == 'ADMIN'
          || (profile.get('storeIds', []) is list && storeId in profile.get('storeIds', []))
          || (profile.get('assignedStoreIds', []) is list && storeId in profile.get('assignedStoreIds', [])));
    }

    function hasStoreAccess(storeId) {
      let profile = isSignedIn() ? userData() : {};
      let stores = profile.get('storeIds', []);
      let assigned = profile.get('assignedStoreIds', []);
      return isSignedIn() && profile.get('isActive', false) == true
        && (profile.get('role', '') == 'ADMIN'
          || (stores is list && storeId in stores)
          || (assigned is list && storeId in assigned));
    }

    function isSaleCreatedStoreStock(stockId) {
      return request.resource.data.keys().hasOnly([
        'storeId',
        'storeCode',
        'storeName',
        'stockItemType',
        'stockItemCode',
        'stockItemName',
        'uom',
        'openingStock',
        'currentStock',
        'minimumStock',
        'costPerUnit',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.storeId is string
      && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
      && hasStoreAccess(request.resource.data.storeId)
      && request.resource.data.storeCode == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.code
      && request.resource.data.storeName == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.name
      && request.resource.data.stockItemType in ['RAW_INGREDIENT', 'PREP_ITEM', 'FINISHED_GOOD', 'PACKAGING', 'BOUGHT_COMPONENT']
      && request.resource.data.stockItemCode is string
      && request.resource.data.stockItemCode.size() > 0
      && stockId == request.resource.data.storeId + '_' + request.resource.data.stockItemType + '_' + request.resource.data.stockItemCode
      && request.resource.data.stockItemName is string
      && request.resource.data.stockItemName.size() > 0
      && request.resource.data.uom is string
      && request.resource.data.uom.size() > 0
      && request.resource.data.openingStock == 0
      && request.resource.data.minimumStock == 0
      && request.resource.data.costPerUnit is number
      && request.resource.data.currentStock is number
      && request.resource.data.currentStock <= 0;
    }

    function isValidInventoryConsumptionStatus(status) {
      return status in ['APPLIED', 'PENDING_BOM', 'NOT_REQUIRED'];
    }

    function hasValidInventoryConsumptionStatus(data) {
      return !data.keys().hasAny(['inventoryConsumptionStatus'])
        || isValidInventoryConsumptionStatus(data.inventoryConsumptionStatus);
    }

    function isValidPaymentMethod(method) {
      return method in ['CASH', 'UPI', 'CARD', 'SWIGGY', 'ZOMATO', 'CREDIT', 'COMPLIMENTARY', 'PAY_AT_COUNTER', 'ONLINE'];
    }

    function isValidPaymentReversalStatus(status) {
      return status in ['NOT_REQUIRED', 'REFUNDED', 'REVERSED', 'REFUND_PENDING', 'MANUAL_REFUND_REQUIRED'];
    }

    function isValidIndianMobile(phone) {
      return phone is string && phone.matches('^[6-9][0-9]{9}$');
    }

    function complimentaryAuthorizationPath(authorizationId) {
      return /databases/$(database)/documents/complimentaryAuthorizations/$(authorizationId);
    }

    function posAddOnAuthorizationPath(authorizationId) {
      return /databases/$(database)/documents/posAddOnAuthorizations/$(authorizationId);
    }

    function hasValidComplimentaryAuthorization(data, orderId) {
      return data.complimentaryAuthorizationId is string
        && data.complimentaryAuthorizationId.size() > 0
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.status == 'VERIFIED'
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.storeId == data.storeId
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.customerPhoneE164 == '+91' + data.customerPhone
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.staffUid == request.auth.uid
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.provider == data.complimentaryOtpProvider
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.expiresAt is timestamp
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.expiresAt > request.time
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.used == true
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.usedAt is timestamp
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.usedByOrderId == orderId
        && getAfter(complimentaryAuthorizationPath(data.complimentaryAuthorizationId)).data.usedByOrderNumber == data.orderNumber;
    }

    function isValidComplimentaryOrderCreate(data, orderId) {
      return data.commercialStatus == 'COMPLIMENTARY'
        && data.paymentMethod == 'COMPLIMENTARY'
        && data.paymentStatus == 'NOT_REQUIRED'
        && data.subtotal is number
        && data.subtotal > 0
        && data.menuValue == data.subtotal
        && data.discountPercent == 100
        && data.discountAmount == data.subtotal
        && data.discountTotal == data.subtotal
        && data.discount == data.subtotal
        && data.complimentaryDiscount == data.subtotal
        && data.taxableAmount == 0
        && data.taxTotal == 0
        && data.gstTotal == 0
        && data.grandTotal == 0
        && data.customerName is string
        && data.customerName.size() > 0
        && isValidIndianMobile(data.customerPhone)
        && data.complimentaryReason is string
        && data.complimentaryReason.size() > 0
        && data.complimentaryOtpVerified == true
        && data.complimentaryVerifiedPhone == data.customerPhone
        && data.complimentaryOtpProvider is string
        && data.complimentaryOtpProvider.size() > 0
        && data.complimentaryAuthorisedByUid == request.auth.uid
        && data.complimentaryAuthorisedByName is string
        && data.complimentaryAuthorisedByName.size() > 0
        && data.complimentaryAuthorisedAt is timestamp
        && !data.keys().hasAny(['otp', 'otpCode', 'oneTimePassword', 'verificationCode'])
        && hasValidComplimentaryAuthorization(data, orderId);
    }

    function isValidSaleOrderCreate(data) {
      return (!data.keys().hasAny(['commercialStatus']) || data.commercialStatus == 'SALE')
        && data.paymentStatus in ['PAID', 'UNPAID', 'PARTIAL']
        && isValidPaymentMethod(data.paymentMethod)
        && data.paymentMethod != 'COMPLIMENTARY';
    }

    function isStoredComplimentaryOrder(data) {
      return data.get('commercialStatus', '') == 'COMPLIMENTARY'
        || data.get('paymentMethod', '') == 'COMPLIMENTARY';
    }

    function isValidKotStatus(status) {
      return status in ['PENDING', 'PREPARING', 'READY', 'SERVED', 'RETURNED', 'WASTAGE_RECORDED', 'REMAKE_REQUESTED', 'CANCELLED'];
    }

    function orderAfter(orderId) {
      return getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function orderItemAfter(orderId, itemId) {
      return getAfter(/databases/$(database)/documents/orders/$(orderId)/items/$(itemId)).data;
    }

    function hasValidPosAddOnAuthorization(data, orderId, authorization) {
      return data.addOnAuthorizationId is string
        && data.addOnAuthorizationId.size() > 0
        && authorization.provider == 'SERVER_CANONICAL_ADD_ONS'
        && authorization.staffUid == request.auth.uid
        && authorization.storeId == data.storeId
        && authorization.orderId == orderId
        && authorization.orderNumber == data.orderNumber
        && authorization.canonicalAddOnTotal == data.addOnTotal
        && authorization.expiresAt is timestamp
        && authorization.expiresAt > request.time
        && authorization.used == true
        && authorization.usedAt is timestamp
        && ((!data.keys().hasAny(['source']) || data.source != 'CUSTOMER_WEB')
          || (data.keys().hasAll(['onlineOrderId'])
            && data.onlineOrderId is string
            && authorization.keys().hasAll(['sourceOnlineOrderId'])
            && authorization.sourceOnlineOrderId == data.onlineOrderId));
    }

    function orderTotalsUnchanged() {
      return request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.taxTotal == resource.data.taxTotal
        && request.resource.data.gstTotal == resource.data.gstTotal
        && request.resource.data.taxableAmount == resource.data.taxableAmount
        && request.resource.data.discountPercent == resource.data.discountPercent
        && request.resource.data.discountAmount == resource.data.discountAmount
        && request.resource.data.discountTotal == resource.data.discountTotal
        && request.resource.data.discount == resource.data.discount
        && request.resource.data.grandTotal == resource.data.grandTotal
        && request.resource.data.cogsTotal == resource.data.cogsTotal;
    }

    function orderIdentityUnchanged() {
      return request.resource.data.storeId == resource.data.storeId
        && request.resource.data.storeCode == resource.data.storeCode
        && request.resource.data.storeName == resource.data.storeName
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.orderNumber == resource.data.orderNumber;
    }

    function sameMoney(actual, expected) {
      return actual is number && expected is number && actual >= 0
        && math.abs(actual - expected) < 0.000001;
    }
    function isFrozenOnlineAuthorization(authorization, order) {
      return authorization.keys().hasAll(['sourceOnlineOrderId'])
        && order.get('source', '') == 'CUSTOMER_WEB'
        && order.get('onlineOrderId', '') == authorization.sourceOnlineOrderId;
    }
    function authorizedPaymentAfter(orderId, paymentId, expected) {
      let payment = getAfter(/databases/$(database)/documents/orders/$(orderId)/payments/$(paymentId)).data;
      return payment.method == expected.method && sameMoney(payment.amount, expected.amount)
        && payment.paymentIndex == expected.paymentIndex;
    }
    function authorizedPaymentGroup0(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[0], payments[ids[0]]) && (count == 1 || (authorizedPaymentAfter(orderId, ids[1], payments[ids[1]]) && (count == 2 || (authorizedPaymentAfter(orderId, ids[2], payments[ids[2]]) && (count == 3 || (authorizedPaymentAfter(orderId, ids[3], payments[ids[3]]) && (count == 4 || (authorizedPaymentAfter(orderId, ids[4], payments[ids[4]]) && (count == 5 || (authorizedPaymentGroup5(orderId, ids, payments, count)))))))))));
    }
    function authorizedPaymentGroup5(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[5], payments[ids[5]]) && (count == 6 || (authorizedPaymentAfter(orderId, ids[6], payments[ids[6]]) && (count == 7 || (authorizedPaymentAfter(orderId, ids[7], payments[ids[7]]) && (count == 8 || (authorizedPaymentAfter(orderId, ids[8], payments[ids[8]]) && (count == 9 || (authorizedPaymentAfter(orderId, ids[9], payments[ids[9]]) && (count == 10 || (authorizedPaymentGroup10(orderId, ids, payments, count)))))))))));
    }
    function authorizedPaymentGroup10(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[10], payments[ids[10]]) && (count == 11 || (authorizedPaymentAfter(orderId, ids[11], payments[ids[11]]) && (count == 12 || (authorizedPaymentAfter(orderId, ids[12], payments[ids[12]]) && (count == 13 || (authorizedPaymentAfter(orderId, ids[13], payments[ids[13]]) && (count == 14 || (authorizedPaymentAfter(orderId, ids[14], payments[ids[14]]) && (count == 15 || (authorizedPaymentGroup15(orderId, ids, payments, count)))))))))));
    }
    function authorizedPaymentGroup15(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[15], payments[ids[15]]) && (count == 16 || (authorizedPaymentAfter(orderId, ids[16], payments[ids[16]]) && (count == 17 || (authorizedPaymentAfter(orderId, ids[17], payments[ids[17]]) && (count == 18 || (authorizedPaymentAfter(orderId, ids[18], payments[ids[18]]) && (count == 19 || (authorizedPaymentAfter(orderId, ids[19], payments[ids[19]]) && (count == 20 || (authorizedPaymentGroup20(orderId, ids, payments, count)))))))))));
    }
    function authorizedPaymentGroup20(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[20], payments[ids[20]]) && (count == 21 || (authorizedPaymentAfter(orderId, ids[21], payments[ids[21]]) && (count == 22 || (authorizedPaymentAfter(orderId, ids[22], payments[ids[22]]) && (count == 23 || (authorizedPaymentAfter(orderId, ids[23], payments[ids[23]]) && (count == 24 || (authorizedPaymentAfter(orderId, ids[24], payments[ids[24]]) && (count == 25 || (authorizedPaymentGroup25(orderId, ids, payments, count)))))))))));
    }
    function authorizedPaymentGroup25(orderId, ids, payments, count) {
      return authorizedPaymentAfter(orderId, ids[25], payments[ids[25]]) && (count == 26 || (authorizedPaymentAfter(orderId, ids[26], payments[ids[26]]) && (count == 27 || (authorizedPaymentAfter(orderId, ids[27], payments[ids[27]]) && (count == 28 || (authorizedPaymentAfter(orderId, ids[28], payments[ids[28]]) && (count == 29 || (authorizedPaymentAfter(orderId, ids[29], payments[ids[29]]) && (count == 30 || (true))))))))));
    }
    function hasAuthorizedPayments(orderId, f) {
      let ids = f.paymentIds;
      let count = ids.size();
      return ids is list && count <= 30 && (count == 0 || authorizedPaymentGroup0(orderId, ids, f.payments, count));
    }
    // Temporary dual-version bridge. Original authorizations have no financial plan.
    // All bases below come from the server-only immutable canonicalItems map.
    function bridgeMoney(actual, expected) {
      // Expected values are arithmetic over immutable server-canonical numbers.
      return actual is number && actual >= 0 && math.abs(actual - expected) < 0.000001;
    }
    function basisAdd(a, b) { return {'subtotal': a.subtotal + b.subtotal, 'tax': a.tax + b.tax}; }
    function legacyAddOnTaxAt(addOns, i) {
      return i < addOns.size() ? addOns[i].totalPrice * addOns[i].taxRate / 100.0 : 0;
    }
    function legacyAddOnTaxGroup0(a) { return legacyAddOnTaxAt(a, 0) + legacyAddOnTaxAt(a, 1) + legacyAddOnTaxAt(a, 2) + legacyAddOnTaxAt(a, 3) + legacyAddOnTaxAt(a, 4); }
    function legacyAddOnTaxGroup1(a) { return legacyAddOnTaxAt(a, 5) + legacyAddOnTaxAt(a, 6) + legacyAddOnTaxAt(a, 7) + legacyAddOnTaxAt(a, 8) + legacyAddOnTaxAt(a, 9); }
    function legacyAddOnTaxGroup2(a) { return legacyAddOnTaxAt(a, 10) + legacyAddOnTaxAt(a, 11) + legacyAddOnTaxAt(a, 12) + legacyAddOnTaxAt(a, 13) + legacyAddOnTaxAt(a, 14); }
    function legacyAddOnTaxGroup3(a) { return legacyAddOnTaxAt(a, 15) + legacyAddOnTaxAt(a, 16) + legacyAddOnTaxAt(a, 17) + legacyAddOnTaxAt(a, 18) + legacyAddOnTaxAt(a, 19); }
    function legacyAddOnTaxGroup4(a) { return legacyAddOnTaxAt(a, 20) + legacyAddOnTaxAt(a, 21) + legacyAddOnTaxAt(a, 22) + legacyAddOnTaxAt(a, 23) + legacyAddOnTaxAt(a, 24); }
    function legacyAddOnTaxGroup5(a) { return legacyAddOnTaxAt(a, 25) + legacyAddOnTaxAt(a, 26) + legacyAddOnTaxAt(a, 27) + legacyAddOnTaxAt(a, 28) + legacyAddOnTaxAt(a, 29); }
    function legacyAddOnTaxGroup6(a) { return legacyAddOnTaxAt(a, 30) + legacyAddOnTaxAt(a, 31) + legacyAddOnTaxAt(a, 32) + legacyAddOnTaxAt(a, 33) + legacyAddOnTaxAt(a, 34); }
    function legacyAddOnTaxGroup7(a) { return legacyAddOnTaxAt(a, 35) + legacyAddOnTaxAt(a, 36) + legacyAddOnTaxAt(a, 37) + legacyAddOnTaxAt(a, 38) + legacyAddOnTaxAt(a, 39); }
    function legacyLineBasis(line) {
      let a = line.addOns;
      let addOnTax = a.size() == 0 ? 0 : a.size() == 1 ? a[0].totalPrice * a[0].taxRate / 100.0 : (a.size() > 0 ? legacyAddOnTaxGroup0(a) : 0) + (a.size() > 5 ? legacyAddOnTaxGroup1(a) : 0) + (a.size() > 10 ? legacyAddOnTaxGroup2(a) : 0) + (a.size() > 15 ? legacyAddOnTaxGroup3(a) : 0) + (a.size() > 20 ? legacyAddOnTaxGroup4(a) : 0) + (a.size() > 25 ? legacyAddOnTaxGroup5(a) : 0) + (a.size() > 30 ? legacyAddOnTaxGroup6(a) : 0) + (a.size() > 35 ? legacyAddOnTaxGroup7(a) : 0);
      return {'subtotal': (line.baseUnitPrice + line.addOnTotal) * line.quantity,
        'tax': (line.baseUnitPrice * line.taxRate / 100.0 + addOnTax) * line.quantity};
    }
    function legacyRawSubtotal0(items, count) {
      return count >= 5 ? items[0].baseUnitPrice * items[0].quantity + items[1].baseUnitPrice * items[1].quantity + items[2].baseUnitPrice * items[2].quantity + items[3].baseUnitPrice * items[3].quantity + items[4].baseUnitPrice * items[4].quantity
        : (count > 0 ? items[0].baseUnitPrice * items[0].quantity : 0) + (count > 1 ? items[1].baseUnitPrice * items[1].quantity : 0) + (count > 2 ? items[2].baseUnitPrice * items[2].quantity : 0) + (count > 3 ? items[3].baseUnitPrice * items[3].quantity : 0) + (count > 4 ? items[4].baseUnitPrice * items[4].quantity : 0);
    }
    function legacyRawTax0(items, count) { return count >= 5 ? legacyLineTax(items[0]) + legacyLineTax(items[1]) + legacyLineTax(items[2]) + legacyLineTax(items[3]) + legacyLineTax(items[4]) : (count > 0 ? legacyLineTax(items[0]) : 0) + (count > 1 ? legacyLineTax(items[1]) : 0) + (count > 2 ? legacyLineTax(items[2]) : 0) + (count > 3 ? legacyLineTax(items[3]) : 0) + (count > 4 ? legacyLineTax(items[4]) : 0); }
    function legacyRawSubtotal1(items, count) {
      return count >= 10 ? items[5].baseUnitPrice * items[5].quantity + items[6].baseUnitPrice * items[6].quantity + items[7].baseUnitPrice * items[7].quantity + items[8].baseUnitPrice * items[8].quantity + items[9].baseUnitPrice * items[9].quantity
        : (count > 5 ? items[5].baseUnitPrice * items[5].quantity : 0) + (count > 6 ? items[6].baseUnitPrice * items[6].quantity : 0) + (count > 7 ? items[7].baseUnitPrice * items[7].quantity : 0) + (count > 8 ? items[8].baseUnitPrice * items[8].quantity : 0) + (count > 9 ? items[9].baseUnitPrice * items[9].quantity : 0);
    }
    function legacyRawTax1(items, count) { return count >= 10 ? legacyLineTax(items[5]) + legacyLineTax(items[6]) + legacyLineTax(items[7]) + legacyLineTax(items[8]) + legacyLineTax(items[9]) : (count > 5 ? legacyLineTax(items[5]) : 0) + (count > 6 ? legacyLineTax(items[6]) : 0) + (count > 7 ? legacyLineTax(items[7]) : 0) + (count > 8 ? legacyLineTax(items[8]) : 0) + (count > 9 ? legacyLineTax(items[9]) : 0); }
    function legacyRawSubtotal2(items, count) {
      return count >= 15 ? items[10].baseUnitPrice * items[10].quantity + items[11].baseUnitPrice * items[11].quantity + items[12].baseUnitPrice * items[12].quantity + items[13].baseUnitPrice * items[13].quantity + items[14].baseUnitPrice * items[14].quantity
        : (count > 10 ? items[10].baseUnitPrice * items[10].quantity : 0) + (count > 11 ? items[11].baseUnitPrice * items[11].quantity : 0) + (count > 12 ? items[12].baseUnitPrice * items[12].quantity : 0) + (count > 13 ? items[13].baseUnitPrice * items[13].quantity : 0) + (count > 14 ? items[14].baseUnitPrice * items[14].quantity : 0);
    }
    function legacyRawTax2(items, count) { return count >= 15 ? legacyLineTax(items[10]) + legacyLineTax(items[11]) + legacyLineTax(items[12]) + legacyLineTax(items[13]) + legacyLineTax(items[14]) : (count > 10 ? legacyLineTax(items[10]) : 0) + (count > 11 ? legacyLineTax(items[11]) : 0) + (count > 12 ? legacyLineTax(items[12]) : 0) + (count > 13 ? legacyLineTax(items[13]) : 0) + (count > 14 ? legacyLineTax(items[14]) : 0); }
    function legacyRawSubtotal3(items, count) {
      return count >= 20 ? items[15].baseUnitPrice * items[15].quantity + items[16].baseUnitPrice * items[16].quantity + items[17].baseUnitPrice * items[17].quantity + items[18].baseUnitPrice * items[18].quantity + items[19].baseUnitPrice * items[19].quantity
        : (count > 15 ? items[15].baseUnitPrice * items[15].quantity : 0) + (count > 16 ? items[16].baseUnitPrice * items[16].quantity : 0) + (count > 17 ? items[17].baseUnitPrice * items[17].quantity : 0) + (count > 18 ? items[18].baseUnitPrice * items[18].quantity : 0) + (count > 19 ? items[19].baseUnitPrice * items[19].quantity : 0);
    }
    function legacyRawTax3(items, count) { return count >= 20 ? legacyLineTax(items[15]) + legacyLineTax(items[16]) + legacyLineTax(items[17]) + legacyLineTax(items[18]) + legacyLineTax(items[19]) : (count > 15 ? legacyLineTax(items[15]) : 0) + (count > 16 ? legacyLineTax(items[16]) : 0) + (count > 17 ? legacyLineTax(items[17]) : 0) + (count > 18 ? legacyLineTax(items[18]) : 0) + (count > 19 ? legacyLineTax(items[19]) : 0); }
    function legacyRawSubtotal4(items, count) {
      return count >= 25 ? items[20].baseUnitPrice * items[20].quantity + items[21].baseUnitPrice * items[21].quantity + items[22].baseUnitPrice * items[22].quantity + items[23].baseUnitPrice * items[23].quantity + items[24].baseUnitPrice * items[24].quantity
        : (count > 20 ? items[20].baseUnitPrice * items[20].quantity : 0) + (count > 21 ? items[21].baseUnitPrice * items[21].quantity : 0) + (count > 22 ? items[22].baseUnitPrice * items[22].quantity : 0) + (count > 23 ? items[23].baseUnitPrice * items[23].quantity : 0) + (count > 24 ? items[24].baseUnitPrice * items[24].quantity : 0);
    }
    function legacyRawTax4(items, count) { return count >= 25 ? legacyLineTax(items[20]) + legacyLineTax(items[21]) + legacyLineTax(items[22]) + legacyLineTax(items[23]) + legacyLineTax(items[24]) : (count > 20 ? legacyLineTax(items[20]) : 0) + (count > 21 ? legacyLineTax(items[21]) : 0) + (count > 22 ? legacyLineTax(items[22]) : 0) + (count > 23 ? legacyLineTax(items[23]) : 0) + (count > 24 ? legacyLineTax(items[24]) : 0); }
    function legacyRawSubtotal5(items, count) {
      return count >= 30 ? items[25].baseUnitPrice * items[25].quantity + items[26].baseUnitPrice * items[26].quantity + items[27].baseUnitPrice * items[27].quantity + items[28].baseUnitPrice * items[28].quantity + items[29].baseUnitPrice * items[29].quantity
        : (count > 25 ? items[25].baseUnitPrice * items[25].quantity : 0) + (count > 26 ? items[26].baseUnitPrice * items[26].quantity : 0) + (count > 27 ? items[27].baseUnitPrice * items[27].quantity : 0) + (count > 28 ? items[28].baseUnitPrice * items[28].quantity : 0) + (count > 29 ? items[29].baseUnitPrice * items[29].quantity : 0);
    }
    function legacyRawTax5(items, count) { return count >= 30 ? legacyLineTax(items[25]) + legacyLineTax(items[26]) + legacyLineTax(items[27]) + legacyLineTax(items[28]) + legacyLineTax(items[29]) : (count > 25 ? legacyLineTax(items[25]) : 0) + (count > 26 ? legacyLineTax(items[26]) : 0) + (count > 27 ? legacyLineTax(items[27]) : 0) + (count > 28 ? legacyLineTax(items[28]) : 0) + (count > 29 ? legacyLineTax(items[29]) : 0); }
    function legacyLineTax(line) {
      let a = line.addOns;
