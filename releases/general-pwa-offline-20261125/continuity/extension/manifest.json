{
  "manifest_version": 3,
  "name": "Coffee Bond offline session clock",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://us-central1-coffee-bond-pos.cloudfunctions.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://pos.coffeebond.in/*"
    ]
  },
  "background": {
    "service_worker": "clock.js",
    "type": "module"
  }
}
